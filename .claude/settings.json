{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Edit(/README.md)",
      "Bash(svn ci *)",
      "Bash(svn commit *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Bash(./ci/build.sh*)",
      "Bash(ci/build.sh*)",
      "Bash(sh ci/build.sh*)",
      "Bash(sh ./ci/build.sh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -Eq '\\.env([^.A-Za-z0-9_-]|$)' && { echo 'Blocked by .claude/settings.json: this command touches a .env file. Ask the maintainer to edit it; .env.example is fine.' >&2; exit 2; } || exit 0",
            "statusMessage": "Checking for .env access"
          }
        ]
      }
    ]
  }
}
