{
    "name": "mariovalney/cf7-to-zapier",
    "description": "CF7 to Webhook: use Contact Form 7 as a trigger to any webhook.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "CFTZ\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:cf7": "phpunit -c phpunit-cf7.xml.dist"
    }
}
